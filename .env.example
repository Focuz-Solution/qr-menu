# Copy to .env and replace the placeholders.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qr_menu"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Generate once with openssl rand -base64 32. Keep the same key after deployment.
ENCRYPTION_KEY="replace-with-generated-base64-key"
APP_BASE_URL="https://your-app.example.com"
TELEGRAM_WEBHOOK_SECRET="replace-with-generated-webhook-secret"

# Optional sample catalogue when running npm run db:seed.
SEED_SAMPLE_DATA="0"
