# Copy to .env and replace the placeholders.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qr_menu"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Folder inside the bucket for photos (optional, default "images"), e.g. "qr-menu/images".
R2_FOLDER="demo"

# One Telegram bot for every shop: create it with @BotFather (/newbot) and paste its token here.
# Shops connect their group in Admin → Telegram → Connect group (no token for them to type).
TELEGRAM_BOT_TOKEN="123456789:replace-with-bot-token-from-botfather"

# The public site's address (your domain, no "/" at the end). Used for QR codes, shop links, link previews and
# Telegram buttons. Each deployment sets its own (Vercel → Settings → Environment Variables). On Vercel it falls
# back to the project's production domain; locally to the address you open.
APP_BASE_URL="https://your-domain.com"
# Secret Telegram sends with every webhook call (32+ letters/digits/_/-, e.g. openssl rand -hex 32). Needs an https
# APP_BASE_URL; without one (local) the admin page reads the bot's messages itself while you connect.
TELEGRAM_WEBHOOK_SECRET="replace-with-generated-webhook-secret"
