generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id          String            @id @default(uuid(7)) @db.Uuid
  slug        String            @unique
  /// shown at the app's main address (app.com/, /products/…, /checkout) as well as at app.com/<slug>; at most one shop (set by the super-admin)
  isDefault   Boolean           @default(false) @map("is_default")
  settings    ShopSettings?
  telegram    TelegramSettings?
  memberships Membership[]
  sessions    Session[]
  categories  Category[]
  items       Item[]
  zones       DeliveryZone[]
  orders      Order[]
  counters    OrderCounter[]
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("shops")
}

model ShopSettings {
  shopId          String   @id @map("shop_id") @db.Uuid
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  logoUrl         String?  @map("logo_url")
  brandColor      String?  @map("brand_color")
  brandText       String?  @map("brand_text")
  softColor       String?  @map("soft_color")
  currency        String   @default("USD")
  khrRate         Int?     @map("khr_rate")
  orderPrefix     String   @default("PB-") @map("order_prefix")
  orderingEnabled Boolean  @default(true) @map("ordering_enabled")
  minOrderCents   Int      @default(0) @map("min_order_cents")
  contactPhone    String?  @map("contact_phone")
  telegramUrl     String?  @map("telegram_url")
  facebookUrl     String?  @map("facebook_url")
  tiktokUrl       String?  @map("tiktok_url")
  address         String   @default("")
  /// the shop's location on Google Maps (https link), null = not set
  mapUrl          String?  @map("map_url")
  hours           String   @default("")
  language        String   @default("km")
  notice          String   @default("")
  layout          String   @default("scroll")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

enum Role {
  owner
  admin
  staff
  packer
}

model User {
  id             String       @id @default(uuid(7)) @db.Uuid
  /// sign-in: an email, a phone (+855…, E.164), or both — at least one (checked in code)
  email          String?      @unique
  phone          String?      @unique
  passwordHash   String       @map("password_hash")
  name           String
  /// super-admin: creates shops, sees and manages every shop
  isOwner        Boolean      @default(false) @map("is_owner")
  memberships    Membership[]
  isActive       Boolean      @default(true) @map("is_active")
  failedLogins   Int          @default(0) @map("failed_logins")
  lockedUntil    DateTime?    @map("locked_until")
  lastLoginAt    DateTime?    @map("last_login_at")
  telegramUserId BigInt?      @unique @map("telegram_user_id")
  sessions       Session[]
  orderEvents    OrderEvent[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model Membership {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String   @map("shop_id") @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// old fixed role — only used until the person gets a role from the Roles page (roleId); see lib/permissions.ts
  role      Role     @default(staff)
  /// the person's role in this shop (Admin → Roles); its permissions decide what they can do here
  roleId    String?    @map("role_id") @db.Uuid
  staffRole StaffRole? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, shopId])
  @@index([roleId])
  @@index([shopId])
  @@map("memberships")
}

/// A role people get in a shop (Manager, Cashier, Packer…): made by the owner on Admin → Roles, shared by every shop.
/// `permissions` = keys from lib/permissions.ts. The owner (User.isOwner) has every permission and needs no role.
model StaffRole {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// the three built-in roles made from the old fixed ones ("admin" | "staff" | "packer"); null = made by the owner
  key         String?      @unique
  name        String
  permissions String[]     @default([])
  sortOrder   Int          @default(0) @map("sort_order")
  memberships Membership[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("staff_roles")
}

/// wrong-password counter per computer (IP), shared by every server instance (admin login rate limit)
model LoginThrottle {
  /// sha256 of the IP — the address itself isn't stored
  key       String   @id
  fails     Int      @default(0)
  /// the count is forgotten after this; with 5+ fails, the computer waits until then
  until     DateTime
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([until])
  @@map("login_throttles")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String?  @map("shop_id") @db.Uuid
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  items     Item[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, slug])
  @@index([shopId, sortOrder])
  @@map("categories")
}

enum Badge {
  new
  best_seller
  sale
}

model Item {
  id             String      @id @default(uuid(7)) @db.Uuid
  shopId         String      @map("shop_id") @db.Uuid
  shop           Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug           String
  categoryId     String      @map("category_id") @db.Uuid
  category       Category    @relation(fields: [categoryId], references: [id])
  name           String
  brand          String?
  description    String      @default("")
  priceCents     Int         @map("price_cents")
  compareAtCents Int?        @map("compare_at_cents")
  badge          Badge?
  isAvailable    Boolean     @default(true) @map("is_available")
  isVisible      Boolean     @default(true) @map("is_visible")
  sortOrder      Int         @default(0) @map("sort_order")
  variants       Json        @default("[]")
  images         ItemImage[]
  orderItems     OrderItem[]
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([shopId, slug])
  @@index([categoryId, sortOrder])
  @@map("items")
}

model ItemImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  itemId    String  @map("item_id") @db.Uuid
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  width     Int?
  height    Int?
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")

  @@index([itemId, sortOrder])
  @@map("item_images")
}

model DeliveryZone {
  id            String   @id @default(uuid(7)) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  provinceCodes String[] @map("province_codes")
  feeCents      Int      @map("fee_cents")
  freeOverCents Int?     @map("free_over_cents")
  eta           String   @default("")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([shopId, sortOrder])
  @@map("delivery_zones")
}

enum OrderStatus {
  new
  confirmed
  packing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  bank_transfer
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

model Order {
  id                String        @id @default(uuid(7)) @db.Uuid
  shopId            String        @map("shop_id") @db.Uuid
  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderNo           String        @map("order_no")
  status            OrderStatus   @default(new)
  customerName      String        @map("customer_name")
  customerPhone     String        @map("customer_phone")
  customerPhoneRaw  String        @map("customer_phone_raw")
  customerTelegram  String?       @map("customer_telegram")
  provinceCode      String        @map("province_code")
  provinceName      String        @map("province_name")
  districtName      String?       @map("district_name")
  communeName       String?       @map("commune_name")
  addressLine       String        @map("address_line")
  landmark          String?
  mapUrl            String?       @map("map_url")
  lat               Float?
  lng               Float?
  note              String?
  deliveryZoneName  String        @map("delivery_zone_name")
  subtotalCents     Int           @map("subtotal_cents")
  deliveryFeeCents  Int           @map("delivery_fee_cents")
  discountCents     Int           @default(0) @map("discount_cents")
  totalCents        Int           @map("total_cents")
  paymentMethod     PaymentMethod @default(cod) @map("payment_method")
  paymentStatus     PaymentStatus @default(unpaid) @map("payment_status")
  source            String        @default("web")
  idempotencyKey    String?       @unique @map("idempotency_key")
  ipHash            String?       @map("ip_hash")
  userAgent         String?       @map("user_agent")
  telegramMessageId BigInt?       @map("telegram_message_id")
  confirmedAt       DateTime?     @map("confirmed_at")
  packedAt          DateTime?     @map("packed_at")
  shippedAt         DateTime?     @map("shipped_at")
  deliveredAt       DateTime?     @map("delivered_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelReason      String?       @map("cancel_reason")
  items             OrderItem[]
  events            OrderEvent[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([shopId, orderNo])
  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, customerPhone, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId         String? @map("item_id") @db.Uuid
  item           Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name           String
  variant        String?
  imageUrl       String? @map("image_url")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int     @map("line_total_cents")

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          String
  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus? @map("to_status")
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorTelegram Json?        @map("actor_telegram")
  payload       Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderCounter {
  shopId String @map("shop_id") @db.Uuid
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  day    String
  value  Int    @default(0)

  @@id([shopId, day])
  @@map("order_counters")
}

/// one row per shop
model TelegramSettings {
  shopId          String    @id @map("shop_id") @db.Uuid
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chatId          BigInt?   @map("chat_id")
  chatTitle       String?   @map("chat_title")
  messageThreadId Int?      @map("message_thread_id")
  /// one-time code in the "add to group" link (t.me/<bot>?startgroup=<code>); cleared once a group is linked
  connectCode     String?   @unique @map("connect_code")
  connectExpires  DateTime? @map("connect_expires")
  /// the admin who pressed Connect: their Telegram account (the one adding the bot) is linked to them
  connectUserId   String?   @map("connect_user_id") @db.Uuid
  isEnabled       Boolean   @default(false) @map("is_enabled")
  lastTestAt      DateTime? @map("last_test_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("telegram_settings")
}
