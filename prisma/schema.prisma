generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ShopSettings {
  id              Int      @id @default(1)
  name            String
  logoUrl         String?  @map("logo_url")
  brandColor      String?  @map("brand_color")
  brandText       String?  @map("brand_text")
  softColor       String?  @map("soft_color")
  currency        String   @default("USD")
  khrRate         Int?     @map("khr_rate")
  orderPrefix     String   @default("PB-") @map("order_prefix")
  orderingEnabled Boolean  @default(true) @map("ordering_enabled")
  minOrderCents   Int      @default(0) @map("min_order_cents")
  contactPhone    String?  @map("contact_phone")
  telegramUrl     String?  @map("telegram_url")
  facebookUrl     String?  @map("facebook_url")
  tiktokUrl       String?  @map("tiktok_url")
  address         String   @default("")
  hours           String   @default("")
  language        String   @default("km")
  notice          String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

enum Role {
  owner
  staff
  packer
}

model User {
  id             String       @id @default(uuid(7)) @db.Uuid
  email          String       @unique
  passwordHash   String       @map("password_hash")
  name           String
  role           Role         @default(staff)
  isActive       Boolean      @default(true) @map("is_active")
  failedLogins   Int          @default(0) @map("failed_logins")
  lockedUntil    DateTime?    @map("locked_until")
  lastLoginAt    DateTime?    @map("last_login_at")
  telegramUserId BigInt?      @unique @map("telegram_user_id")
  sessions       Session[]
  orderEvents    OrderEvent[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  items     Item[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

enum Badge {
  new
  best_seller
  sale
}

model Item {
  id             String      @id @default(uuid(7)) @db.Uuid
  slug           String      @unique
  categoryId     String      @map("category_id") @db.Uuid
  category       Category    @relation(fields: [categoryId], references: [id])
  name           String
  brand          String?
  description    String      @default("")
  priceCents     Int         @map("price_cents")
  compareAtCents Int?        @map("compare_at_cents")
  badge          Badge?
  isAvailable    Boolean     @default(true) @map("is_available")
  isVisible      Boolean     @default(true) @map("is_visible")
  sortOrder      Int         @default(0) @map("sort_order")
  variants       Json        @default("[]")
  images         ItemImage[]
  orderItems     OrderItem[]
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([categoryId, sortOrder])
  @@map("items")
}

model ItemImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  itemId    String  @map("item_id") @db.Uuid
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  width     Int?
  height    Int?
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")

  @@index([itemId, sortOrder])
  @@map("item_images")
}

model DeliveryZone {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  provinceCodes String[] @map("province_codes")
  feeCents      Int      @map("fee_cents")
  freeOverCents Int?     @map("free_over_cents")
  eta           String   @default("")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
}

enum OrderStatus {
  new
  confirmed
  packing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  bank_transfer
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

model Order {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderNo           String        @unique @map("order_no")
  status            OrderStatus   @default(new)
  customerName      String        @map("customer_name")
  customerPhone     String        @map("customer_phone")
  customerPhoneRaw  String        @map("customer_phone_raw")
  customerTelegram  String?       @map("customer_telegram")
  provinceCode      String        @map("province_code")
  provinceName      String        @map("province_name")
  districtName      String?       @map("district_name")
  communeName       String?       @map("commune_name")
  addressLine       String        @map("address_line")
  landmark          String?
  mapUrl            String?       @map("map_url")
  lat               Float?
  lng               Float?
  note              String?
  deliveryZoneName  String        @map("delivery_zone_name")
  subtotalCents     Int           @map("subtotal_cents")
  deliveryFeeCents  Int           @map("delivery_fee_cents")
  discountCents     Int           @default(0) @map("discount_cents")
  totalCents        Int           @map("total_cents")
  paymentMethod     PaymentMethod @default(cod) @map("payment_method")
  paymentStatus     PaymentStatus @default(unpaid) @map("payment_status")
  source            String        @default("web")
  idempotencyKey    String?       @unique @map("idempotency_key")
  ipHash            String?       @map("ip_hash")
  userAgent         String?       @map("user_agent")
  telegramMessageId BigInt?       @map("telegram_message_id")
  confirmedAt       DateTime?     @map("confirmed_at")
  packedAt          DateTime?     @map("packed_at")
  shippedAt         DateTime?     @map("shipped_at")
  deliveredAt       DateTime?     @map("delivered_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelReason      String?       @map("cancel_reason")
  items             OrderItem[]
  events            OrderEvent[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([customerPhone, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId         String? @map("item_id") @db.Uuid
  item           Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name           String
  variant        String?
  imageUrl       String? @map("image_url")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int     @map("line_total_cents")

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          String
  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus? @map("to_status")
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorTelegram Json?        @map("actor_telegram")
  payload       Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderCounter {
  day   String @id
  value Int    @default(0)

  @@map("order_counters")
}

model TelegramSettings {
  id              Int       @id @default(1)
  botTokenEnc     String?   @map("bot_token_enc")
  botUsername     String?   @map("bot_username")
  chatId          BigInt?   @map("chat_id")
  chatTitle       String?   @map("chat_title")
  messageThreadId Int?      @map("message_thread_id")
  webhookSecret   String?   @map("webhook_secret")
  isEnabled       Boolean   @default(false) @map("is_enabled")
  lastTestAt      DateTime? @map("last_test_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("telegram_settings")
}
